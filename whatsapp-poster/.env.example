# Copy this file to `.env` in this directory and fill in real values.
# Do NOT put real values in a committed file — .gitignore ignores .env but not .env.example.

# --- WhatsApp session ---
# Directory whatsapp-web.js's LocalAuth uses to persist the authenticated session
# so you don't need to re-scan the QR code every restart.
WWEBJS_SESSION_DIR=.wwebjs_auth

# The WhatsApp chat ID of the target group/community, e.g. 1203630XXXXXXXXXX@g.us
# Find this by running: npm run list-chats  (after your first QR login)
WHATSAPP_TARGET_CHAT_ID=

# --- Google Sheets ---
# The Sheet ID from its URL (.../spreadsheets/d/<THIS>/edit)
SHEET_ID=11uuS0piwPgvNTRAgX1585m2zOEgXB-Ugjwa_LYTQPRw

# The tab's gid (from ...#gid=<THIS>). Resolved to a sheet *title* at runtime
# (values.get needs a title, not a gid) via one spreadsheets.get metadata call.
SHEET_GID=4667324

# Path to the downloaded Google service-account JSON key (gitignored). The
# service account's client_email must be shared on the Sheet as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json

# --- Column mapping (by header name, case-insensitive) ---
# Defaults shown; override only if your sheet's headers differ.
SHEET_COL_DATE=Date
SHEET_COL_MESSAGE=Message
SHEET_COL_STATUS=Status
SHEET_COL_MEDIA_URL=Media URL

# Value written into the Status column (with a timestamp appended) once a message sends.
SHEET_STATUS_POSTED_VALUE=Posted

# --- Scheduling ---
# 24h HH:mm, evaluated in TIMEZONE below.
POST_TIME=09:00
TIMEZONE=America/New_York

# --- Local idempotency fallback ---
STATE_FILE_PATH=./data/posted-state.json

# --- Logging ---
LOG_DIR=./logs
LOG_LEVEL=info
